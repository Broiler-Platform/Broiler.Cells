<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishAot>true</PublishAot>
    <Configurations>Debug;Release;Debug-Windows;Release-Windows</Configurations>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug-Windows' Or '$(Configuration)' == 'Release-Windows'">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Broiler.Cells.Core/Broiler.Cells.Core.csproj" />
    <ProjectReference Include="../Broiler.Cells.Controls/Broiler.Cells.Controls.csproj" />
    <ProjectReference Include="../Broiler.Cells.UI/Broiler.Cells.UI.csproj" />
    <PackageReference Include="Broiler.Graphics.Windows" />
    <PackageReference Include="Broiler.Hosting.Windows" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Cells.Tests" />
  </ItemGroup>
</Project>
